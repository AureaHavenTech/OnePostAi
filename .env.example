# ============================================
# OnePost AI — Environment Variables
# ============================================
# Copy this file to .env and fill in your keys.
# NEVER commit .env to GitHub.
#
# Usage: cp .env.example .env
# ============================================

# --- Server ---
PORT=3001                       # Backend API port
NODE_ENV=production             # development | production | test

# --- OpenAI (AI Content Generation) ---
OPENAI_API_KEY=sk-              # OpenAI API key (GPT-4o for scripts, captions, hashtags, hooks)

# --- Stripe (Payments) ---
STRIPE_SECRET_KEY=sk_live_      # Stripe live secret key
STRIPE_PUBLISHABLE_KEY=pk_live_ # Stripe live publishable key
STRIPE_WEBHOOK_SECRET=whsec_    # Stripe webhook signing secret

# --- Social Media Platform API Keys ---
# TikTok
TIKTOK_ACCESS_TOKEN=            # TikTok access token (for publishing)
TIKTOK_APP_ID=                  # TikTok app ID

# Instagram / Meta (Facebook)
INSTAGRAM_ACCESS_TOKEN=         # Instagram Graph API access token
FACEBOOK_APP_ID=                # Facebook app ID
FACEBOOK_APP_SECRET=            # Facebook app secret

# YouTube
YOUTUBE_API_KEY=                # YouTube Data API v3 key
YOUTUBE_CLIENT_ID=              # OAuth2 client ID
YOUTUBE_CLIENT_SECRET=          # OAuth2 client secret

# LinkedIn
LINKEDIN_CLIENT_ID=             # LinkedIn app client ID
LINKEDIN_CLIENT_SECRET=         # LinkedIn app client secret
LINKEDIN_ACCESS_TOKEN=          # LinkedIn access token

# Snapchat
SNAPCHAT_CLIENT_ID=             # Snapchat marketing API client ID
SNAPCHAT_CLIENT_SECRET=         # Snapchat marketing API client secret

# Pinterest
PINTEREST_ACCESS_TOKEN=         # Pinterest API access token
PINTEREST_APP_ID=               # Pinterest app ID

# --- Shopify (E-commerce) ---
SHOPIFY_API_KEY=                # Shopify admin API key
SHOPIFY_API_SECRET=             # Shopify admin API secret
SHOPIFY_STORE_DOMAIN=           # e.g., mystore.myshopify.com

# --- AI Image/Video Generation ---
HEYGEN_API_KEY=                 # HeyGen AI avatar video generation
SYNTHESIA_API_KEY=              # Synthesia AI video generation
MIDJOURNEY_API_KEY=             # Midjourney image generation (if available)
STABILITY_API_KEY=              # Stability AI (SDXL) image generation

# --- Database ---
# These are auto-configured when using team-db
# TEAM_DB_AUTH_TOKEN=           # Team database auth token (automatic)
# TEAM_DB_EVENTS_TOKEN=         # Team database events token (automatic)

# --- Vercel (already configured) ---
# VERCEL_TOKEN=                 # Vercel API token (already set in CI)
# VERCEL_ORG_ID=                # Vercel organization ID
# VERCEL_PROJECT_ID=            # Vercel project ID

# --- Frontend (Next.js Public) ---
NEXT_PUBLIC_APP_URL=https://onepostai.ctonew.app
NEXT_PUBLIC_API_URL=https://onepostai.ctonew.app/api
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_

# --- Email (Transactional) ---
# RESEND_API_KEY=               # Resend for transactional emails
# SENDGRID_API_KEY=             # SendGrid alternative

# --- Sentry (Error Monitoring) ---
# SENTRY_DSN=                   # Sentry DSN for error tracking
